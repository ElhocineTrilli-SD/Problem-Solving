--===========================================
-- Department Salary Report
--===========================================

-- Declare variables
DECLARE @DepartmentID INT;
DECLARE @DepartmentName NVARCHAR(30);

DECLARE @TotalEmployees INT;
DECLARE @TotalSalary MONEY;
DECLARE @AverageSalary MONEY;
DECLARE @HighestSalary MONEY;
DECLARE @LowestSalary MONEY;

-- Assign values to variables
SET @DepartmentID = 5;


-- Calculate department statistics
SELECT 
    @TotalEmployees = COUNT(*),
    @TotalSalary = SUM(Salary),
    @AverageSalary = AVG(Salary),
    @HighestSalary = MAX(Salary),
    @LowestSalary = MIN(Salary)
FROM Employees
WHERE DepartmentID = @DepartmentID;

-- Get department name
SELECT
    @DepartmentName = DepartmentName
FROM Departments
WHERE DepartmentID = @DepartmentID;

PRINT '==========================';
PRINT 'Department Salary Report';
PRINT '==========================';

PRINT 'Department Name : ' + @DepartmentName;
PRINT 'Total Employees : ' + CAST(@TotalEmployees AS NVARCHAR);
PRINT 'Total Salary    : ' + CAST(@TotalSalary AS NVARCHAR);
PRINT 'Average Salary  : ' + CAST(@AverageSalary AS NVARCHAR);
PRINT 'Highest Salary  : ' + CAST(@HighestSalary AS NVARCHAR);
PRINT 'Lowest Salary   : ' + CAST(@LowestSalary AS NVARCHAR);
