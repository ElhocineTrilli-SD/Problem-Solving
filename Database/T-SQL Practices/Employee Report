-- Employee Report
--===========================================

-- Declare variables
DECLARE @EmployeeID INT;
DECLARE @FullName NVARCHAR(30);
DECLARE @DepartmentName NVARCHAR(30);
DECLARE @Salary INT;
DECLARE @HireDate DATE;

-- Assign values to variables
SET @EmployeeID = 5;
select 
@FullName      = FullName,
@DeprtmentName = DepartmentName,
@Salary        = Salary,
@HirDate       = HireDate
From Employees
WHERE EmployeeID = @EmployeeID;
