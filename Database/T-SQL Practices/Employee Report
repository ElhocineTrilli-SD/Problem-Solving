--===========================================
-- Employee Report
--===========================================

-- Declare variables
DECLARE @EmployeeID INT;
DECLARE @FullName NVARCHAR(30);
DECLARE @DepartmentName NVARCHAR(30);
DECLARE @Salary INT;
DECLARE @HireDate DATE;

-- Assign values to variables
SET @EmployeeID = 5;
select 
@FullName      = FullName,
@DeprtmentName = DepartmentName,
@Salary        = Salary,
@HirDate       = HireDate
From Employees
inner join Departments d 
on Employees.DepartmentID = d.DepartmentID
WHERE EmployeeID = @EmployeeID;

PRINT '==========================';
PRINT 'Employee Report';
PRINT '==========================';

PRINT 'Employee ID   : ' + CAST(@EmployeeID AS NVARCHAR);
PRINT 'Employee Name : ' + @FullName;
PRINT 'Department    : ' + @DepartmentName;
PRINT 'Salary        : ' + CAST(@Salary AS NVARCHAR);
PRINT 'Hire Date     : ' + CAST(@HireDate AS NVARCHAR);
